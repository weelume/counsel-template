{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "PORT": {
      "type": "string",
      "description": "本地 HTTP 服务端口，默认 43628",
      "x-secret": false,
      "x-exposure": "server"
    },
    "HOSTNAME": {
      "type": "string",
      "description": "监听地址，默认 127.0.0.1",
      "x-secret": false,
      "x-exposure": "server"
    }
  }
}
